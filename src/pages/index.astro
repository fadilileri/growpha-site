<script>
	const counters = document.querySelectorAll<HTMLElement>('[data-countup]');
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const el = entry.target as HTMLElement;
				if (el.dataset.done) return;
				el.dataset.done = 'true';
				const target = Number(el.dataset.target || '0');
				const suffix = el.dataset.suffix || '';
				const duration = 1400;
				const start = performance.now();
				function tick(now: number) {
					const progress = Math.min((now - start) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					el.textContent = Math.round(eased * target) + suffix;
					if (progress < 1) requestAnimationFrame(tick);
				}
				requestAnimationFrame(tick);
				observer.unobserve(el);
			});
		},
		{ threshold: 0.4 },
	);
	counters.forEach((el) => observer.observe(el));

	const slides = Array.from(document.querySelectorAll<HTMLElement>('.testimonial-slide'));
	const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-t-dot]'));
	const slideColors = slides.map((s) => s.querySelector<HTMLElement>('.quote-mark')?.style.color || '');
	let current = 0;
	let timer: ReturnType<typeof setInterval> | undefined;

	function showSlide(index: number) {
		current = (index + slides.length) % slides.length;
		slides.forEach((s, i) => {
			s.style.display = i === current ? '' : 'none';
		});
		dots.forEach((d, i) => {
			d.classList.toggle('active', i === current);
			d.style.background = i === current ? slideColors[current] : '';
		});
	}

	document.querySelector('[data-t-prev]')?.addEventListener('click', () => showSlide(current - 1));
	document.querySelector('[data-t-next]')?.addEventListener('click', () => showSlide(current + 1));
	dots.forEach((dot, i) => dot.addEventListener('click', () => showSlide(i)));

	const testimonialSection = document.querySelector('.testimonials-section');
	function startAutoplay() {
		timer = setInterval(() => showSlide(current + 1), 6000);
	}
	function stopAutoplay() {
		if (timer) clearInterval(timer);
	}
	if (slides.length > 1) {
		startAutoplay();
		testimonialSection?.addEventListener('mouseenter', stopAutoplay);
		testimonialSection?.addEventListener('mouseleave', startAutoplay);
	}
</script>

