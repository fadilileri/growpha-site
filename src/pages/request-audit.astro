		margin-bottom: 20px;
	}
	.ra-h1 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(2.25rem, 4.5vw, 3.25rem);
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0 0 16px;
		color: var(--growpha-text-primary);
	}
	.ra-lead {
		color: var(--growpha-text-secondary);
		font-size: 1.0625rem;
		line-height: 1.7;
		max-width: 640px;
		margin: 0 0 28px;
	}
	.ra-price-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 20px;
		margin-bottom: 28px;
	}
