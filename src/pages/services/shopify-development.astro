---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ToolsMarquee from '../../components/service/ToolsMarquee.astro';
import FeatureGrid from '../../components/service/FeatureGrid.astro';
import ProcessSteps from '../../components/service/ProcessSteps.astro';
import Deliverables from '../../components/service/Deliverables.astro';
import FaqAccordion from '../../components/service/FaqAccordion.astro';
import AuditBanner from '../../components/service/AuditBanner.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';

const tools = [
	{ title: 'Shopify', src: 'https://cdn.simpleicons.org/shopify/ffffff' },
	{ title: 'Analytics', src: 'https://cdn.simpleicons.org/googleanalytics/ffffff' },
	{ title: 'Search Console', src: 'https://cdn.simpleicons.org/googlesearchconsole/ffffff' },
	{ title: 'SEMrush', src: 'https://cdn.simpleicons.org/semrush/ffffff' },
	{ title: 'Ahrefs', initials: 'AH' },
	{ title: 'Google Ads', src: 'https://cdn.simpleicons.org/googleads/ffffff' },
];

const features = [
	{ title: 'Custom Theme Development', desc: 'Bespoke Shopify themes built from scratch or heavily customised from a base theme — designed to your brand, not a template.' },
	{ title: 'Conversion Rate Optimisation', desc: 'Product page structure, checkout flow, and UX decisions made with conversion data in mind — not just aesthetics.' },
	{ title: 'SEO Architecture', desc: 'Clean URL structures, proper canonical handling, schema markup, and site architecture designed for organic search performance.' },
	{ title: 'Performance Optimisation', desc: 'Core Web Vitals optimisation, image delivery, script management, and server-side performance for fast load times.' },
	{ title: 'App Integration', desc: 'Selecting the right Shopify apps — and removing the ones that slow your store down.' },
	{ title: 'Platform Migrations', desc: 'Migrating from WooCommerce, Magento, or other platforms to Shopify with zero data loss and minimal ranking disruption.' },
];

const processSteps = [
	{ title: 'Discovery & Scoping', desc: 'Understanding your business, products, customer journey, and technical requirements.' },
	{ title: 'Design & Architecture', desc: 'Designing the store structure, page templates, and user flows before any development begins.' },
	{ title: 'Development & Integration', desc: 'Building the theme, integrating apps, and configuring the store to specification.' },
	{ title: 'Testing, Launch & Handover', desc: 'QA testing across devices, launch, and a full CMS handover so your team can manage the store independently.' },
];

const deliverables = [
	'Custom Shopify theme',
	'SEO-optimised product architecture',
	'Conversion-focused page templates',
	'Core Web Vitals optimisation',
	'Schema markup implementation',
	'App integration and configuration',
	'Launch checklist and QA',
	'Post-launch support',
];

const caseStudies = [
	{ industry: 'Fashion & Apparel', metric: '+68%', metricLabel: 'Organic Revenue', title: 'Custom Shopify Theme for Fashion Brand', challenge: 'Existing theme was bloating page load times above 6 seconds and the product page structure was suppressing category rankings.', result: 'Rebuilt on a custom Liquid theme with lazy-loaded imagery and structured data. Core Web Vitals moved to "Good" across all metrics.' },
	{ industry: 'Health & Supplements', metric: '-23pts', metricLabel: 'Cart Abandonment', title: 'Shopify Migration from WooCommerce', challenge: 'WooCommerce store was suffering from slow hosting, plugin conflicts, and a checkout abandonment rate above 74%.', result: 'Full migration to Shopify with redirect mapping, custom checkout flow, and subscription app integration. Abandonment rate dropped to 51%.' },
	{ industry: 'Home & Interiors', metric: '3×', metricLabel: 'Trade Order Volume', title: 'Shopify B2B Trade Portal', challenge: 'Trade customers needed a separate pricing and ordering experience without a separate store instance.', result: 'Built a Shopify B2B portal using customer tags, metafields, and custom Liquid logic — no third-party app required.' },
	{ industry: 'Sports & Outdoors', metric: '4', metricLabel: 'Markets Launched', title: 'Shopify Internationalisation', challenge: 'Single-market store needed to expand to 4 European markets with localised pricing, currency, and translated content.', result: 'Implemented Shopify Markets with hreflang, localised URLs, and currency conversion. Launched across UK, DE, FR, and NL simultaneously.' },
];

const faqs = [
	{ q: 'How long does a Shopify build take?', a: 'A standard Shopify build with a custom theme typically takes 4–6 weeks from kickoff to launch. Migrations from another platform or stores with complex app integrations and custom functionality can take longer. A clear timeline is agreed at the start based on your specific scope.' },
	{ q: 'Do I need a custom theme or can I use a template?', a: "Off-the-shelf themes work for simple stores, but heavily customised or built-from-scratch themes give you full control over performance, conversion flow, and brand expression — without fighting a template's constraints. Growpha recommends the right approach based on your budget, timeline, and how differentiated your store needs to be." },
	{ q: 'Can you migrate my store from WooCommerce or Magento to Shopify?', a: 'Yes — platform migrations are a core part of the Shopify development service, including full redirect mapping to preserve SEO value, product and customer data migration, and checkout/app parity so nothing is lost in the switch.' },
	{ q: 'How do you keep Shopify stores fast despite apps?', a: "Every app added to a Shopify store carries a performance cost. Growpha audits the real cost of each app, removes anything not driving measurable revenue, and defer-loads what remains so Core Web Vitals stay in the 'Good' range even as functionality grows." },
	{ q: 'Will my Shopify store be SEO-ready?', a: 'Yes — clean URL structures, canonical handling for filtered/sorted collection views, schema markup, and collection page architecture are built in from the start, not retrofitted after launch.' },
];

const related = [
	{ label: 'Web Development', href: '/services/web-development' },
	{ label: 'WordPress Development', href: '/services/wordpress-development' },
	{ label: 'Technical SEO', href: '/services/technical-seo' },
	{ label: 'On-Page SEO', href: '/services/on-page-seo' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Shopify Development Agency in Dubai | Growpha"
			description="Shopify stores built for conversion, not just commerce: fast load times, clean architecture, and SEO-ready product pages for Dubai e-commerce brands."
		/>
	</head>
	<body>
		<Header />
		<main>
			<ServiceHero
				crumb="Shopify Development"
				label="Shopify Development"
				title="Shopify stores built for"
				titleAccent="conversion, not just commerce."
				lead="Shopify development at Growpha is about building stores that perform — fast load times, clean architecture, SEO-ready product pages, and conversion flows that actually convert. Not themes with minor customisations."
				primaryLabel="Discuss Your Shopify Project"
				secondaryLabel="← Back to Web Development"
				secondaryHref="/services/web-development"
			/>
			<ToolsMarquee label="Tools & Platforms Used" tools={tools} />
			<FeatureGrid label="What This Covers" title="Built for measurable outcomes," titleAccent="not activity metrics." features={features} />
			<ProcessSteps label="The Process" title="How we approach" titleAccent="shopify development." intro="Every engagement follows a structured process — audit first, strategy second, execution third. No guesswork, no assumptions." steps={processSteps} />
			<Deliverables label="Deliverables & Outcomes" title="What you get from working with Growpha." intro="Clear outputs, documented processes, and measurable results — not activity reports that obscure whether anything is actually working." items={deliverables} ctaLabel="Discuss Your Project" />

			<section class="case-section">
				<div class="gp-container">
					<div class="section-label">Case Studies</div>
					<h2 class="case-h2">Projects that moved<br /><span class="text-gradient-orange">the needle.</span></h2>
					<div class="case-total"><span class="case-total-value">10+</span><span class="case-total-label">Shopify Stores Built</span></div>
					<div class="case-grid">
						{
							caseStudies.map((c) => (
								<div class="growpha-card case-card">
									<div class="case-tags">
										<span class="case-platform">Shopify</span>
										<span class="case-industry">{c.industry}</span>
									</div>
									<div class="case-metric text-gradient-orange">{c.metric}</div>
									<div class="case-metric-label">{c.metricLabel}</div>
									<h3 class="case-title">{c.title}</h3>
									<div class="case-block"><span>Challenge</span><p>{c.challenge}</p></div>
									<div class="case-block"><span>Result</span><p>{c.result}</p></div>
								</div>
							))
						}
					</div>
					<a href="/contact" class="ghero-btn-ghost">Discuss your project</a>
				</div>
			</section>

			<FaqAccordion items={faqs} />
			<AuditBanner />
			<RelatedServices items={related} />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		padding: 0;
		margin: 0;
	}
	.case-section {
		background: var(--growpha-surface-1);
		padding: 40px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}
	.case-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
		margin: 16px 0 20px;
		color: var(--growpha-text-primary);
	}
	.case-total {
		display: flex;
		flex-direction: column;
		margin-bottom: 32px;
	}
	.case-total-value {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: 2rem;
		color: var(--growpha-green-bright);
	}
	.case-total-label {
		font-size: 0.8125rem;
		color: var(--growpha-text-muted);
	}
	.case-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		margin-bottom: 32px;
	}
	@media (min-width: 768px) {
		.case-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.case-tags {
		display: flex;
		gap: 8px;
		margin-bottom: 16px;
	}
	.case-platform {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--growpha-green-bright);
		background: rgba(34, 197, 94, 0.1);
		border: 1px solid rgba(34, 197, 94, 0.2);
		border-radius: 999px;
		padding: 4px 10px;
	}
	.case-industry {
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--growpha-text-muted);
		align-self: center;
	}
	.case-metric {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: 2rem;
		letter-spacing: -0.03em;
	}
	.case-metric-label {
		font-size: 0.8125rem;
		color: var(--growpha-text-muted);
		margin-bottom: 16px;
	}
	.case-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.0625rem;
		color: var(--growpha-text-primary);
		margin: 0 0 16px;
	}
	.case-block {
		margin-bottom: 12px;
	}
	.case-block span {
		display: block;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--growpha-text-muted);
		margin-bottom: 4px;
	}
	.case-block p {
		font-size: 0.875rem;
		color: var(--growpha-text-secondary);
		line-height: 1.6;
		margin: 0;
	}
</style>
