---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ToolsMarquee from '../../components/service/ToolsMarquee.astro';
import FeatureGrid from '../../components/service/FeatureGrid.astro';
import ProcessSteps from '../../components/service/ProcessSteps.astro';
import Deliverables from '../../components/service/Deliverables.astro';
import FaqAccordion from '../../components/service/FaqAccordion.astro';
import AuditBanner from '../../components/service/AuditBanner.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';

const tools = [
	{ title: 'SEMrush', src: 'https://cdn.simpleicons.org/semrush/ffffff' },
	{ title: 'Ahrefs', initials: 'AH' },
	{ title: 'Screaming Frog', initials: 'SF' },
	{ title: 'Search Console', src: 'https://cdn.simpleicons.org/googlesearchconsole/ffffff' },
	{ title: 'Analytics', src: 'https://cdn.simpleicons.org/googleanalytics/ffffff' },
	{ title: 'Moz', initials: 'MO' },
];

const features = [
	{ title: 'Crawl Efficiency', desc: 'Ensuring Googlebot can access and process your most important pages without wasting crawl budget on low-value URLs.' },
	{ title: 'Core Web Vitals', desc: "Optimising LCP, INP, and CLS to meet Google's performance standards and improve real-world user experience signals." },
	{ title: 'Structured Data', desc: 'Schema markup implementation that helps search engines understand your content and enables rich results.' },
	{ title: 'Indexing Control', desc: 'Canonical tags, noindex directives, and sitemap management to control exactly what gets indexed and how.' },
	{ title: 'Site Architecture', desc: 'URL structure, internal linking, and information architecture designed for both users and crawlers.' },
	{ title: 'Log File Analysis', desc: 'Understanding how Googlebot actually crawls your site — not just how you think it does.' },
];

const processSteps = [
	{ title: 'Technical Audit', desc: 'A comprehensive review of crawlability, indexing, site speed, structured data, and architecture issues.' },
	{ title: 'Priority Mapping', desc: 'Issues ranked by impact and effort — so fixes happen in the right order.' },
	{ title: 'Implementation', desc: 'Direct fixes or developer-ready specifications, depending on your team setup.' },
	{ title: 'Validation & Monitoring', desc: 'Confirming fixes are live and monitoring for regressions over time.' },
];

const deliverables = [
	'Full technical audit report',
	'Prioritised issue list with fix specifications',
	'Core Web Vitals improvement plan',
	'Structured data implementation',
	'Crawl efficiency recommendations',
	'Indexing control review',
	'Site architecture recommendations',
	'Ongoing monitoring setup',
];

const faqs = [
	{
		q: 'What is technical SEO and why does it matter?',
		a: "Technical SEO refers to the process of optimising your website's infrastructure so that search engines can efficiently crawl, interpret, and index your content. It covers site architecture, page speed, Core Web Vitals, structured data, canonical tags, and crawl budget management. Without a solid technical foundation, even the best content and link-building efforts will underperform. Growpha treats technical SEO as the non-negotiable starting point for any serious organic growth strategy.",
	},
	{
		q: 'How do I know if my website has technical SEO issues?',
		a: 'Common signs include slow page load times, pages not appearing in Google Search Console, duplicate content warnings, crawl errors, or a significant gap between pages on your site and pages indexed by Google. A professional technical audit using tools like Screaming Frog, Ahrefs, and Google Search Console will surface the full picture. Growpha conducts comprehensive technical audits as the first step of every engagement, producing a prioritised list of issues with clear remediation guidance.',
	},
	{
		q: 'What are Core Web Vitals and do they affect rankings?',
		a: 'Core Web Vitals are Google\'s standardised metrics for measuring real-world user experience: Largest Contentful Paint (LCP) for loading speed, Interaction to Next Paint (INP) for responsiveness, and Cumulative Layout Shift (CLS) for visual stability. Google confirmed Core Web Vitals as a ranking signal in 2021 and continues to refine their weighting. Failing these metrics can suppress rankings in competitive categories, particularly on mobile. Growpha optimises all three as part of its technical SEO service.',
	},
	{
		q: 'How long does it take to fix technical SEO problems?',
		a: 'Simple fixes such as adding canonical tags, correcting redirect chains, or updating robots.txt can be implemented within days. More complex structural issues, such as a site-wide architecture overhaul or a JavaScript rendering problem, may take several weeks to resolve and validate. The timeline also depends on developer resource availability and how quickly changes can be deployed. Growpha provides a phased remediation plan so high-impact fixes are prioritised and implemented first.',
	},
	{
		q: 'Is technical SEO a one-time fix or an ongoing process?',
		a: 'Technical SEO requires both an initial remediation phase and ongoing maintenance. New content, site updates, CMS changes, and Google algorithm shifts can introduce new technical issues over time. Regular crawl monitoring, log file analysis, and performance tracking are essential to catch regressions before they impact rankings. Growpha includes ongoing technical monitoring as part of its retained SEO service to ensure the foundation remains sound as the site grows.',
	},
];

const related = [
	{ label: 'On-Page SEO', href: '/services/on-page-seo' },
	{ label: 'Off-Page SEO', href: '/services/off-page-seo' },
	{ label: 'Web Development', href: '/services/web-development' },
	{ label: 'AI / LLM SEO', href: '/services/ai-llm-seo' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Technical SEO Services in Dubai | Growpha"
			description="Technical SEO for Dubai businesses: crawlability, indexation, and rendering fixes that determine whether your site can rank at all."
		/>
	</head>
	<body>
		<Header />
		<main>
			<ServiceHero
				crumb="Technical SEO"
				label="Technical SEO"
				title="The infrastructure that makes"
				titleAccent="everything else possible."
				lead="Technical SEO is not a checklist. It is the architectural foundation that determines whether your content can be found, crawled, understood, and ranked. Without it, everything else is guesswork."
				primaryLabel="Request a Technical Audit"
				primaryHref="/request-audit"
				secondaryLabel="← Back to SEO"
				secondaryHref="/services/seo"
			/>
			<ToolsMarquee label="Tools & Platforms Used" tools={tools} />
			<FeatureGrid label="What This Covers" title="Built for measurable outcomes," titleAccent="not activity metrics." features={features} />
			<ProcessSteps label="The Process" title="How we approach" titleAccent="technical seo." intro="Every engagement follows a structured process — audit first, strategy second, execution third. No guesswork, no assumptions." steps={processSteps} />
			<Deliverables label="Deliverables & Outcomes" title="What you get from working with Growpha." intro="Clear outputs, documented processes, and measurable results — not activity reports that obscure whether anything is actually working." items={deliverables} ctaLabel="Discuss Your Project" />
			<FaqAccordion items={faqs} />
			<AuditBanner />
			<RelatedServices items={related} />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		padding: 0;
		margin: 0;
	}
</style>
