---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ToolsMarquee from '../../components/service/ToolsMarquee.astro';
import FeatureGrid from '../../components/service/FeatureGrid.astro';
import ProcessSteps from '../../components/service/ProcessSteps.astro';
import Deliverables from '../../components/service/Deliverables.astro';
import FaqAccordion from '../../components/service/FaqAccordion.astro';
import AuditBanner from '../../components/service/AuditBanner.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';

const tools = [
	{ title: 'Ahrefs', initials: 'AH' },
	{ title: 'SEMrush', src: 'https://cdn.simpleicons.org/semrush/ffffff' },
	{ title: 'Moz', initials: 'MO' },
	{ title: 'Search Console', src: 'https://cdn.simpleicons.org/googlesearchconsole/ffffff' },
	{ title: 'Clearbit', initials: 'CL' },
];

const features = [
	{ title: 'Link Acquisition', desc: 'Earning high-quality backlinks from relevant, authoritative sources through content, outreach, and digital PR.' },
	{ title: 'Digital PR', desc: 'Generating editorial coverage and brand mentions in publications that build both authority and brand recognition.' },
	{ title: 'Brand Mentions', desc: "Building unlinked brand mentions and entity associations that contribute to Google's understanding of your brand." },
	{ title: 'Competitor Gap Analysis', desc: 'Identifying the link sources your competitors have that you do not — and building a strategy to close the gap.' },
	{ title: 'Link Profile Audit', desc: 'Reviewing your existing backlink profile for toxic links, lost links, and opportunities to reclaim or disavow.' },
	{ title: 'Anchor Text Strategy', desc: 'Managing anchor text distribution to build a natural, diverse link profile that avoids over-optimisation penalties.' },
];

const processSteps = [
	{ title: 'Link Profile Audit', desc: 'Reviewing your existing backlink profile — quality, diversity, anchor text distribution, and toxic links.' },
	{ title: 'Competitor Analysis', desc: 'Mapping the link sources your top competitors have and identifying the most achievable opportunities.' },
	{ title: 'Outreach & Acquisition', desc: 'Executing a targeted link acquisition strategy through content, digital PR, and relationship-based outreach.' },
	{ title: 'Monitoring & Reporting', desc: 'Tracking new links, lost links, and domain authority changes over time.' },
];

const deliverables = [
	'Link profile audit report',
	'Competitor backlink gap analysis',
	'Link acquisition strategy',
	'Digital PR content plan',
	'Monthly link acquisition reporting',
	'Toxic link identification',
	'Anchor text distribution review',
	'Brand mention monitoring setup',
];

const faqs = [
	{
		q: 'What is off-page SEO and why is it important?',
		a: "Off-page SEO refers to all the actions taken outside your own website to improve its search engine rankings. The most significant off-page signal is backlinks — links from other websites pointing to yours. Search engines treat backlinks as votes of confidence: a link from a high-authority, relevant source tells Google that your content is trustworthy and worth ranking. Beyond backlinks, off-page SEO includes brand mentions, social signals, and entity associations that contribute to how Google understands and values your brand.",
	},
	{
		q: 'How many backlinks do I need to rank on the first page of Google?',
		a: 'There is no fixed number — it depends entirely on the competitiveness of the keyword and the quality of the links pointing to your competitors. A local business might rank with a handful of strong local citations, while a national e-commerce site competing for high-volume terms may need hundreds of high-authority links. Growpha conducts a competitive link gap analysis to determine the realistic link acquisition targets for your specific market, focusing on quality and relevance over raw volume.',
	},
	{
		q: 'What is the difference between a good backlink and a bad backlink?',
		a: 'A good backlink comes from a website that is relevant to your industry, has genuine editorial authority, and links to you naturally within the context of useful content. A bad backlink comes from a low-quality, spammy, or irrelevant site — often purchased in bulk or placed through link schemes. Bad backlinks can trigger Google penalties and actively harm your rankings. Growpha focuses exclusively on editorial link acquisition and digital PR, avoiding any tactics that violate Google\'s guidelines.',
	},
	{
		q: 'Does digital PR count as off-page SEO?',
		a: 'Yes — digital PR is one of the most effective off-page SEO strategies available. When your brand earns coverage in authoritative publications, you typically receive high-quality editorial backlinks alongside brand exposure. These links carry significant authority because they are earned, not bought, and come from sources Google already trusts. Growpha integrates digital PR into its off-page SEO strategy to build both link authority and brand recognition simultaneously.',
	},
	{
		q: 'Can I buy backlinks to rank faster?',
		a: "Buying backlinks is a violation of Google's Webmaster Guidelines and carries significant risk of manual penalties or algorithmic suppression. While paid links can produce short-term ranking gains, the long-term consequences — including ranking drops, deindexation, and the cost of link removal — far outweigh any temporary benefit. Growpha does not engage in paid link schemes. All link acquisition is editorial, earned through content quality, outreach, and digital PR.",
	},
];

const related = [
	{ label: 'Technical SEO', href: '/services/technical-seo' },
	{ label: 'Content Marketing', href: '/services/content-marketing' },
	{ label: 'Wikipedia Creation', href: '/services/wikipedia-creation' },
	{ label: 'On-Page SEO', href: '/services/on-page-seo' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Off-Page SEO | Growpha"
			description="Off-page SEO builds the external signals that tell search engines your site is credible, relevant, and worth ranking."
		/>
	</head>
	<body>
		<Header />
		<main>
			<ServiceHero
				crumb="Off-Page SEO"
				label="Off-Page SEO"
				title="Authority that search engines"
				titleAccent="cannot ignore."
				lead="Off-page SEO is about building the external signals that tell search engines your site is credible, relevant, and worth ranking. Done properly, it is a long-term competitive moat — not a link-buying exercise."
				primaryLabel="Request a Link Audit"
				primaryHref="/request-audit"
				secondaryLabel="← Back to SEO"
				secondaryHref="/services/seo"
			/>
			<ToolsMarquee label="Tools & Platforms Used" tools={tools} />
			<FeatureGrid label="What This Covers" title="Built for measurable outcomes," titleAccent="not activity metrics." features={features} />
			<ProcessSteps label="The Process" title="How we approach" titleAccent="off-page seo." intro="Every engagement follows a structured process — audit first, strategy second, execution third. No guesswork, no assumptions." steps={processSteps} />
			<Deliverables label="Deliverables & Outcomes" title="What you get from working with Growpha." intro="Clear outputs, documented processes, and measurable results — not activity reports that obscure whether anything is actually working." items={deliverables} ctaLabel="Discuss Your Project" />
			<FaqAccordion items={faqs} />
			<AuditBanner />
			<RelatedServices items={related} />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		padding: 0;
		margin: 0;
	}
</style>
