---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ToolsMarquee from '../../components/service/ToolsMarquee.astro';
import FeatureGrid from '../../components/service/FeatureGrid.astro';
import FaqAccordion from '../../components/service/FaqAccordion.astro';
import ClosingCta from '../../components/service/ClosingCta.astro';
import AuditBanner from '../../components/service/AuditBanner.astro';
import ProcessSteps from '../../components/service/ProcessSteps.astro';
import Conducted from '../../components/service/Conducted.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';

const tools = [
	{ title: 'OpenAI', initials: 'AI' },
	{ title: 'Perplexity', initials: 'PX' },
	{ title: 'Claude', initials: 'CL' },
	{ title: 'SEMrush', src: 'https://cdn.simpleicons.org/semrush/ffffff' },
	{ title: 'Ahrefs', initials: 'AH' },
	{ title: 'Search Console', src: 'https://cdn.simpleicons.org/googlesearchconsole/ffffff' },
];

const shifts = [
	{ before: 'Keyword rankings', now: 'AI citation frequency' },
	{ before: 'Page-level optimisation', now: 'Entity-level authority' },
	{ before: 'Link-based authority', now: 'Knowledge graph presence' },
	{ before: 'Click-through traffic', now: 'Brand visibility in AI answers' },
];

function icon(inner: string) {
	return `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
}

const disciplines = [
	{
		icon: icon('<path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path>'),
		title: 'AI Search Visibility',
		desc: "How ChatGPT, Perplexity, Gemini and Google AI Overviews describe and cite your brand for the UAE queries your buyers ask.",
	},
	{
		icon: icon('<circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle>'),
		title: 'Entity-Based Optimisation',
		desc: "One consistent profile of who you are, what you do and where you're licensed, across your site, schema, Google Business Profile and directories.",
	},
	{
		icon: icon('<path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>'),
		title: 'Citation & Mention Strategy',
		desc: "Finding the UAE and industry sources AI tools cite in your category, from regional media to directories and Wikipedia, and earning a place on them.",
	},
	{
		icon: icon('<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path>'),
		title: 'LLM Content Structuring',
		desc: "Priority pages rewritten with direct answers, clear headings and checkable facts that language models can retrieve, summarise and attribute.",
	},
	{
		icon: icon('<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>'),
		title: 'Search Experience Shifts',
		desc: "Which of your queries now show AI answers or zero-click results, what that does to your traffic, and where to adapt first.",
	},
	{
		icon: icon('<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path>'),
		title: 'Technical Content Foundations',
		desc: "Schema, crawl access for AI bots and machine-readable site signals that help AI systems parse and trust your content.",
	},
];

const realityPoints = [
	'Optimisation for ChatGPT, Perplexity and AI Overviews',
	'A baseline of how AI describes your brand today',
	'Entity and knowledge graph development',
	'Consistent details across UAE directories and GBP',
	'UAE and industry citation strategy',
	'Structured content for LLM retrieval',
	'Schema markup for machine readability',
	'Monthly AI visibility and share-of-voice tracking',
];

const processSteps = [
	{ title: 'AI Visibility Audit', desc: 'Your priority queries tested across AI platforms and Google. Fixed price, 999 AED, 10 business days.' },
	{ title: 'Entity & Citation Map', desc: "The sources AI tools trust in your UAE category, and where you're missing or inconsistent." },
	{ title: 'Foundations & Content', desc: 'Schema, entity fixes and priority pages restructured so AI systems can quote you accurately.' },
	{ title: 'Monitoring', desc: 'Mentions, share of voice and AI referral traffic, reported monthly with what to do next.' },
];

const conductedStats = [
	{ value: '10+', label: 'Years in technical SEO' },
	{ value: '6', label: 'Audit areas covered' },
	{ value: '10', label: 'Business days to delivery' },
];

const related = [
	{ label: 'SEO', href: '/services/seo/' },
	{ label: 'Technical SEO', href: '/services/technical-seo/' },
	{ label: 'Local SEO', href: '/services/local-seo/' },
	{ label: 'Wikipedia Creation', href: '/services/wikipedia-creation/' },
];

// The FAQ below is the single source for both the visible accordion and the FAQPage JSON-LD,
// so the markup always matches the on-page text word for word.
const faqs = [
	{
		q: 'What is AI SEO?',
		a: 'AI SEO, sometimes called generative engine optimisation (GEO) or LLM SEO, is the work of making sure AI search tools such as ChatGPT, Perplexity, Gemini and Google AI Overviews understand your business correctly and cite or recommend it. It combines technical SEO, structured data, entity building and citation strategy.',
	},
	{
		q: 'Is AI SEO different from traditional SEO?',
		a: 'It builds on it. Traditional SEO ranks pages for keywords. AI SEO makes sure your brand is represented accurately in AI-generated answers, which may not link to your site. Strong rankings, clean technical foundations and authority still feed AI visibility, so we run both together.',
		link: { text: 'Traditional SEO', href: '/services/seo/' },
	},
	{
		q: 'How much does AI SEO cost in Dubai?',
		a: 'Growpha starts with a fixed-price AI visibility and SEO audit at 999 AED, delivered in 10 days. Ongoing work is priced after the audit, based on scope and competition.',
	},
	{
		q: 'How do I get my business mentioned by ChatGPT or Perplexity?',
		a: "Be consistently described on the sources these tools trust: your own well-structured website, Google Business Profile, UAE business directories, regional and industry media, and reference sites. Then make sure your pages answer your buyers' questions directly. We map which sources matter in your category and close the gaps.",
	},
	{
		q: 'How do I optimise for Google AI Overviews?',
		a: 'AI Overviews mostly draw on pages that already rank well. Focus on strong organic rankings, clear headings with direct answers, accurate schema markup, and visible expertise: real authors, evidence and up-to-date facts.',
	},
	{
		q: 'Do you optimise for Arabic AI search?',
		a: 'Growpha works in English. We optimise your English content and entity data for AI answers in the UAE. If you publish in Arabic too, we make sure your business name, services and location are consistent across both languages, so AI tools recognise them as the same business.',
	},
	{
		q: 'What is answer engine optimisation?',
		a: 'Answer engine optimisation is structuring content so search and AI tools can pull it as a direct answer. In the UAE, "AEO" usually refers to the customs Authorised Economic Operator programme, so we call this answer engine optimisation or GEO to avoid confusion.',
	},
	{
		q: 'Can AI SEO be measured?',
		a: 'Yes, through proxy metrics: mentions and citations in AI answers for a fixed query set, share of voice against competitors, referral traffic from AI tools in GA4, and entity consistency. We set these up in the audit and report on them monthly.',
	},
];

const pageUrl = 'https://growpha.com/services/ai-llm-seo/';
const pageTitle = 'AI SEO Services in Dubai | GEO & LLM Optimisation | Growpha';
const pageDescription =
	"AI SEO in Dubai from a technical SEO consultant with 10+ years' experience. Get your brand cited by ChatGPT, Perplexity and Google AI Overviews.";
const areaServed = [
	{ '@type': 'City', name: 'Dubai' },
	{ '@type': 'Country', name: 'United Arab Emirates' },
];

// Facts included here are only those visible on the site. Add address/telephone and the
// Google Business Profile URL (sameAs) once the licensed business details are confirmed.
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': 'https://growpha.com/#organization',
			name: 'Growpha',
			url: 'https://growpha.com/',
			logo: { '@type': 'ImageObject', url: 'https://growpha.com/logo.png' },
			description: 'Technical SEO, AI search optimisation and digital growth consultancy based in Dubai.',
			founder: { '@id': 'https://growpha.com/who-am-i/#person' },
			areaServed,
		},
		{
			'@type': 'Person',
			'@id': 'https://growpha.com/who-am-i/#person',
			name: 'Fadil İleri',
			jobTitle: 'Founder, Technical SEO & Digital Growth Strategist',
			url: 'https://growpha.com/who-am-i/',
			worksFor: { '@id': 'https://growpha.com/#organization' },
			sameAs: ['https://www.linkedin.com/in/fadilileri34/'],
			knowsAbout: [
				'Generative engine optimisation',
				'AI search visibility',
				'ChatGPT visibility',
				'AI visibility',
			],
		},
		{
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
			url: pageUrl,
			name: pageTitle,
			inLanguage: 'en-AE',
			isPartOf: { '@id': 'https://growpha.com/#website' },
			about: { '@id': `${pageUrl}#service` },
			author: { '@id': 'https://growpha.com/who-am-i/#person' },
			breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
		},
		{
			'@type': 'WebSite',
			'@id': 'https://growpha.com/#website',
			url: 'https://growpha.com/',
			name: 'Growpha',
			publisher: { '@id': 'https://growpha.com/#organization' },
		},
		{
			'@type': 'Service',
			'@id': `${pageUrl}#service`,
			name: 'AI SEO Services in Dubai',
			alternateName: ['Generative engine optimisation', 'LLM SEO', 'AI search optimisation'],
			serviceType: 'AI search optimisation',
			description:
				'Optimisation for AI search platforms including ChatGPT, Perplexity and Google AI Overviews: entity building, citation strategy, LLM content structuring and technical foundations.',
			provider: { '@id': 'https://growpha.com/#organization' },
			areaServed,
			url: pageUrl,
			offers: {
				'@type': 'Offer',
				name: 'SEO and AI search visibility audit',
				price: '999',
				priceCurrency: 'AED',
				url: 'https://growpha.com/request-audit/',
				availability: 'https://schema.org/InStock',
			},
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${pageUrl}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://growpha.com/' },
				{ '@type': 'ListItem', position: 2, name: 'Services', item: 'https://growpha.com/services/' },
				{ '@type': 'ListItem', position: 3, name: 'AI / LLM SEO', item: pageUrl },
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${pageUrl}#faq`,
			mainEntity: faqs.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
			ogTitle="AI SEO Services in Dubai: Get Cited by ChatGPT, Perplexity & AI Overviews"
			ogDescription="Generative engine optimisation for UAE businesses. Fixed-price audit from 999 AED, delivered in 10 days."
			ogImage="/og/ai-llm-seo-dubai.jpg"
			locale="en_AE"
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main>
			<ServiceHero
				crumb="AI / LLM SEO"
				crumbParent={{ label: 'Services', href: '/services/' }}
				label="AI Search Optimisation · Dubai"
				title="AI SEO services in Dubai."
				titleAccent="Get cited by ChatGPT, Perplexity and AI Overviews."
				lead="UAE buyers now ask AI assistants which supplier to shortlist. Growpha makes sure your business is one of the names ChatGPT, Perplexity and Google AI Overviews trust, cite and recommend."
				primaryLabel="Request Your Audit — 999 AED"
				primaryHref="/request-audit/"
				secondaryLabel="Discuss AI Search Strategy"
				secondaryHref="/contact/"
			/>
			<ToolsMarquee label="AI search platforms we optimise for" tools={tools} />

			<section class="shift-section">
				<div class="gp-container">
					<div class="shift-header">
						<div class="section-label">The Search Shift</div>
						<h2 class="shift-h2">What used to work.<br /><span class="text-gradient-orange">What works now.</span></h2>
					</div>
					<div class="shift-grid">
						{
							shifts.map((s) => (
								<div class="shift-row">
									<div class="shift-before">
										<span class="shift-tag">Previously</span>
										<span>{s.before}</span>
									</div>
									<div class="shift-now">
										<span class="shift-tag shift-tag-now">Now</span>
										<span>{s.now}</span>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<FeatureGrid label="What We Do" title="What our AI SEO" titleAccent="service covers." features={disciplines} />

			<section class="reality-section">
				<div class="gp-container">
					<div class="reality-grid">
						<div>
							<div class="section-label">The Reality</div>
							<h2 class="reality-h2">AI is already recommending businesses in Dubai. Is yours one of them?</h2>
							<p class="reality-p">
								When a buyer in DIFC or a founder in a free zone asks an AI assistant for the best provider in
								Dubai, they get a handful of names, not ten blue links. If you're not one of them, you're not
								on the shortlist.
							</p>
							<p class="reality-p">
								Those names come from sources AI trusts: regional media, UAE directories, free-zone registers,
								reviews and well-built websites. Growpha builds your presence across all of them.
							</p>
							<a href="/request-audit/" class="ghero-btn-ghost">Explore AI SEO Strategy</a>
						</div>
						<ul class="reality-list">
							{realityPoints.map((p) => <li>{p}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<ProcessSteps
				label="The Process"
				title="How AI SEO works"
				titleAccent="with Growpha."
				intro="Audit first, strategy second, execution third. Every step is measured against a baseline, so you can see what changed."
				steps={processSteps}
			/>

			<Conducted
				label="Who Does the Work"
				title="Led by the founder."
				titleAccent="Not outsourced."
				text="Every AI SEO engagement is run by Fadil İleri, Growpha's founder: a Dubai-based technical SEO consultant with over ten years' experience across e-commerce, finance, SaaS, real estate and enterprise sites. There's no account-manager layer between you and the person doing the work."
				stats={conductedStats}
				note="Available to meet in person for businesses in DIFC, Business Bay, and JLT."
			/>

			<FaqAccordion title="AI SEO in Dubai: frequently asked questions" items={faqs} schema={false} />

			<ClosingCta
				label="Get Ahead of the Shift"
				title="Become the answer AI gives"
				titleAccent="in your category."
				intro="Most UAE businesses still optimise only for 2020-style search. See how AI tools describe you today, and get there before your competitors."
				ctaLabel="Start the Conversation"
				ctaHref="/contact/"
			/>
			<AuditBanner />
			<RelatedServices items={related} />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		padding: 0;
		margin: 0;
	}
	.shift-section {
		background: var(--growpha-surface-2);
		padding: 40px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}
	.shift-header {
		max-width: 500px;
		margin-bottom: 32px;
	}
	.shift-header .section-label {
		margin-bottom: 16px;
	}
	.shift-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
		margin: 0;
		color: var(--growpha-text-primary);
	}
	.shift-grid {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.shift-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 12px;
		background: var(--growpha-surface-3);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		padding: 18px 20px;
	}
	@media (min-width: 640px) {
		.shift-row {
			grid-template-columns: 1fr 1fr;
			align-items: center;
		}
	}
	.shift-before,
	.shift-now {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.shift-before span:last-child {
		color: var(--growpha-text-muted);
		text-decoration: line-through;
		font-size: 0.9375rem;
	}
	.shift-now span:last-child {
		color: var(--growpha-text-primary);
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.shift-tag {
		font-family: var(--font-heading);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--growpha-text-muted);
		flex-shrink: 0;
		width: 66px;
	}
	.shift-tag-now {
		color: var(--growpha-orange);
	}

	.reality-section {
		background: var(--growpha-surface-1);
		padding: 40px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}
	.reality-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
	}
	@media (min-width: 1024px) {
		.reality-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	.reality-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.5rem, 2.75vw, 2.25rem);
		letter-spacing: -0.025em;
		line-height: 1.15;
		margin: 16px 0;
		color: var(--growpha-text-primary);
	}
	.reality-p {
		color: var(--growpha-text-secondary);
		font-size: 0.9375rem;
		line-height: 1.7;
		margin: 0 0 16px;
	}
	.reality-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
		align-content: start;
	}
	.reality-list li {
		background: var(--growpha-surface-2);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 8px;
		padding: 12px 16px;
		font-size: 0.875rem;
		color: var(--growpha-text-secondary);
	}
</style>
