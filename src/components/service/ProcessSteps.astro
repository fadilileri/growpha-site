---
interface Step {
	title: string;
	desc: string;
}
interface Props {
	label: string;
	title: string;
	titleAccent?: string;
	intro?: string;
	steps: Step[];
	ctaLabel?: string;
	ctaHref?: string;
	columns?: 3 | 4;
}
const { label, title, titleAccent, intro, steps, ctaLabel, ctaHref, columns = 4 } = Astro.props;
---

<section class="proc-section">
	<div class="gp-container">
		<div class="proc-header">
			<div class="section-label">{label}</div>
			<h2 class="proc-h2">
				{title}<br />
				{titleAccent && <span class="text-gradient-orange">{titleAccent}</span>}
			</h2>
			{intro && <p class="proc-intro">{intro}</p>}
			{ctaLabel && (
				<a href={ctaHref} class="ghero-btn-ghost proc-cta">{ctaLabel}</a>
			)}
		</div>
		<div class:list={['proc-grid', `proc-grid-${columns}`]}>
			{
				steps.map((step, i) => (
					<div class="proc-step" style={i % 2 === 0 ? 'background:var(--growpha-surface-3)' : 'background:var(--growpha-surface-2)'}>
						<div class="proc-num">{String(i + 1).padStart(2, '0')}</div>
						<h3 class="proc-title">{step.title}</h3>
						<p class="proc-desc">{step.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.proc-section {
		background: var(--growpha-surface-1);
		padding: 40px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}
	.proc-header {
		margin-bottom: 40px;
		max-width: 640px;
	}
	.proc-header .section-label {
		margin-bottom: 16px;
	}
	.proc-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
		margin: 0 0 12px;
		color: var(--growpha-text-primary);
	}
	.proc-intro {
		color: var(--growpha-text-secondary);
		font-size: 1rem;
		line-height: 1.7;
		margin: 0 0 20px;
	}
	.proc-cta {
		display: inline-flex;
	}
	.proc-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 768px) {
		.proc-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.proc-grid-4 {
			grid-template-columns: repeat(4, 1fr);
		}
		.proc-grid-3 {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.proc-step {
		padding: 24px;
		border-right: 1px solid rgba(255, 255, 255, 0.05);
	}
	.proc-step:last-child {
		border-right: none;
	}
	.proc-num {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: 2.5rem;
		color: rgba(34, 197, 94, 0.15);
		line-height: 1;
		margin-bottom: 20px;
		letter-spacing: -0.04em;
	}
	.proc-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.0625rem;
		color: var(--growpha-text-primary);
		margin: 0 0 10px;
		letter-spacing: -0.01em;
	}
	.proc-desc {
		color: var(--growpha-text-secondary);
		font-size: 0.875rem;
		line-height: 1.65;
		margin: 0;
	}
</style>
