---
interface Platform {
	name: string;
	/** Product or owner line under the name. */
	sub: string;
	logo: string;
	/** Headline figure, e.g. "900M". Omit when the company publishes no user count. */
	stat?: string;
	statLabel: string;
	/** Year-over-year growth, e.g. "+125%". Omit when two comparable official figures don't exist. */
	growth?: string;
	growthNote: string;
	source: string;
}
interface Props {
	label: string;
	title: string;
	titleAccent: string;
	intro: string;
	platforms: Platform[];
	note: string;
}
const { label, title, titleAccent, intro, platforms, note } = Astro.props;
---

<section class="aip-section">
	<div class="gp-container">
		<div class="aip-header">
			<div class="section-label">{label}</div>
			<h2 class="aip-h2">{title}<br /><span class="text-gradient-orange">{titleAccent}</span></h2>
			<p class="aip-intro">{intro}</p>
		</div>
		<div class="aip-grid">
			{
				platforms.map((p) => (
					<div class="growpha-card aip-card">
						<div class="aip-top">
							<span class="aip-logo">
								<img src={p.logo} alt="" width="24" height="24" loading="lazy" decoding="async" />
							</span>
							<div>
								<div class="aip-name">{p.name}</div>
								<div class="aip-sub">{p.sub}</div>
							</div>
						</div>
						{p.stat ? (
							<div class="aip-stat">{p.stat}</div>
						) : (
							<div class="aip-stat aip-stat-none">No official count</div>
						)}
						<div class="aip-stat-label">{p.statLabel}</div>
						{p.growth ? (
							<div class="aip-growth">
								<span class="aip-chip">▲ {p.growth}</span>
								<span class="aip-growth-note">{p.growthNote}</span>
							</div>
						) : (
							<div class="aip-growth">
								<span class="aip-chip aip-chip-muted">Growth not published</span>
								<span class="aip-growth-note">{p.growthNote}</span>
							</div>
						)}
						<div class="aip-source">{p.source}</div>
					</div>
				))
			}
		</div>
		<p class="aip-note">{note}</p>
	</div>
</section>

<style>
	.aip-section {
		background: var(--growpha-surface-1);
		padding: 48px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}
	.aip-header {
		max-width: 640px;
		margin-bottom: 32px;
	}
	.aip-header .section-label {
		margin-bottom: 16px;
	}
	.aip-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
		margin: 0 0 14px;
		color: var(--growpha-text-primary);
	}
	.aip-intro {
		color: var(--growpha-text-secondary);
		font-size: 1rem;
		line-height: 1.7;
		margin: 0;
	}
	.aip-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
	}
	@media (min-width: 560px) {
		.aip-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.aip-card:nth-child(5) {
			grid-column: 1 / -1;
		}
	}
	@media (min-width: 1100px) {
		.aip-grid {
			grid-template-columns: repeat(5, 1fr);
		}
		.aip-card:nth-child(5) {
			grid-column: auto;
		}
	}
	.aip-card {
		display: flex;
		flex-direction: column;
		padding: 20px;
		gap: 0;
	}
	.aip-top {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 20px;
		min-height: 62px;
	}
	.aip-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.08);
		flex-shrink: 0;
	}
	.aip-logo img {
		width: 24px;
		height: 24px;
		display: block;
	}
	.aip-name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1rem;
		color: var(--growpha-text-primary);
		line-height: 1.2;
	}
	.aip-sub {
		font-size: 0.75rem;
		color: var(--growpha-text-muted);
		margin-top: 2px;
	}
	.aip-stat {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: 2.25rem;
		letter-spacing: -0.03em;
		line-height: 1;
		color: var(--growpha-text-primary);
	}
	.aip-stat-none {
		font-size: 1.125rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--growpha-text-muted);
		min-height: 2.25rem;
		display: flex;
		align-items: center;
	}
	.aip-stat-label {
		font-size: 0.8125rem;
		color: var(--growpha-text-muted);
		margin: 6px 0 16px;
		min-height: 2.4em;
	}
	.aip-growth {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		margin-bottom: 16px;
	}
	.aip-chip {
		display: inline-block;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.9375rem;
		color: var(--growpha-green-bright);
		background: rgba(34, 197, 94, 0.12);
		border: 1px solid rgba(34, 197, 94, 0.3);
		border-radius: 999px;
		padding: 4px 12px;
	}
	.aip-chip-muted {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--growpha-text-muted);
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.1);
	}
	.aip-growth-note {
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--growpha-text-secondary);
	}
	.aip-source {
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--growpha-text-muted);
	}
	.aip-note {
		margin: 24px 0 0;
		max-width: 860px;
		font-size: 0.8125rem;
		line-height: 1.7;
		color: var(--growpha-text-muted);
	}
</style>
