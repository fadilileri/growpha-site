---
interface Item {
	label: string;
	href: string;
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
const chevronRight =
	'<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>';
---

<section class="related-section">
	<div class="gp-container">
		<h3 class="related-title">Related Services</h3>
		<div class="related-links">
			{
				items.map((item) => (
					<a href={item.href} class="related-link">
						{item.label}
						<span set:html={chevronRight} />
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.related-section {
		background: var(--growpha-surface-3);
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding: 40px 0;
	}
	.related-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1rem;
		color: var(--growpha-text-muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0 0 20px;
	}
	.related-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.related-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--growpha-text-primary);
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 10px;
		padding: 8px 16px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
		transition: border-color 0.2s, background 0.2s;
	}
	.related-link:hover {
		background: rgba(255, 255, 255, 0.04);
		border-color: rgba(255, 255, 255, 0.3);
	}
</style>
