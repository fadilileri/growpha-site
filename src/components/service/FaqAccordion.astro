---
interface Faq {
	q: string;
	a: string;
}
interface Props {
	title?: string;
	intro?: string;
	items: Faq[];
}
const { title = 'Frequently Asked Questions', intro, items } = Astro.props;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const chevronDown =
	'<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>';
---

<section class="faq-section">
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<div class="gp-container">
		<div class="faq-inner">
			<div class="faq-head">
				<div class="section-label">FAQ</div>
				<h2 class="faq-h2">{title}</h2>
				{intro && <p class="faq-intro">{intro}</p>}
			</div>
			<div class="faq-list">
				{
					items.map((item) => (
						<div class="faq-item">
							<button class="faq-question" aria-expanded="false" data-faq-toggle>
								<h3>{item.q}</h3>
								<span class="faq-chevron" set:html={chevronDown} />
							</button>
							<div class="faq-answer" data-faq-panel>
								<div class="faq-answer-inner">{item.a}</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-faq-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const panel = btn.nextElementSibling as HTMLElement;
			const chevron = btn.querySelector<HTMLElement>('.faq-chevron');
			const isOpen = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!isOpen));
			if (panel) panel.style.maxHeight = isOpen ? '0px' : panel.scrollHeight + 'px';
			if (chevron) chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
		});
	});
</script>

<style>
	.faq-section {
		background: var(--growpha-surface-1);
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding: 32px 0;
	}
	.faq-inner {
		max-width: 760px;
		margin: 0 auto;
	}
	.faq-head {
		margin-bottom: 40px;
	}
	.faq-head .section-label {
		margin-bottom: 16px;
	}
	.faq-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		letter-spacing: -0.025em;
		line-height: 1.1;
		color: var(--growpha-text-primary);
		margin: 0 0 16px;
	}
	.faq-intro {
		color: var(--growpha-text-secondary);
		font-size: 1rem;
		line-height: 1.7;
		margin: 0;
	}
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.faq-item {
		background: var(--growpha-surface-2);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 12px;
		overflow: hidden;
		transition: border-color 0.2s, background 0.2s;
	}
	.faq-question {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		text-align: left;
		padding: 20px 24px;
		background: none;
		border: none;
		cursor: pointer;
	}
	.faq-question h3 {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1rem;
		color: var(--growpha-text-secondary);
		line-height: 1.45;
		margin: 0;
		transition: color 0.2s;
	}
	.faq-question[aria-expanded='true'] h3 {
		color: var(--growpha-text-primary);
	}
	.faq-chevron {
		flex-shrink: 0;
		display: flex;
		color: var(--growpha-text-muted);
		transition: transform 0.25s, color 0.2s;
	}
	.faq-answer {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.3s;
	}
	.faq-answer-inner {
		padding: 0 24px 24px;
		color: var(--growpha-text-secondary);
		font-size: 0.9375rem;
		line-height: 1.75;
		font-family: var(--font-body);
	}
</style>
