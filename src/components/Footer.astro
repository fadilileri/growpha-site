---
import Logo from '../assets/brand/growpha-logo.png';
import { Image } from 'astro:assets';

const today = new Date();

function icon(inner: string, size = 14) {
	return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
}
const arrowRight = icon('<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>', 15);
const circleCheck = icon('<circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path>', 12);
const linkedinIcon = icon(
	'<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle>',
	16,
);

const linkColumns = [
	{
		title: 'SEO',
		links: [
			{ label: 'SEO Overview', href: '/services/seo/' },
			{ label: 'Technical SEO', href: '/services/technical-seo/' },
			{ label: 'On-Page SEO', href: '/services/on-page-seo/' },
			{ label: 'Off-Page SEO', href: '/services/off-page-seo/' },
			{ label: 'Local SEO', href: '/services/local-seo/' },
			{ label: 'YouTube SEO', href: '/services/youtube-seo/' },
			{ label: 'International SEO', href: '/services/international-seo/' },
		],
	},
	{
		title: 'Services',
		links: [
			{ label: 'AI / LLM SEO', href: '/services/ai-llm-seo/' },
			{ label: 'Content Marketing', href: '/services/content-marketing/' },
			{ label: 'AI Automations', href: '/services/ai-automations/' },
			{ label: 'Wikipedia Creation', href: '/services/wikipedia-creation/' },
			{ label: 'Web Development', href: '/services/web-development/' },
			{ label: 'Shopify Development', href: '/services/shopify-development/' },
			{ label: 'WordPress Development', href: '/services/wordpress-development/' },
		],
	},
	{
		title: 'Company',
		links: [
			{ label: 'Home', href: '/' },
			{ label: 'Who Am I', href: '/who-am-i/' },
			{ label: 'Contact', href: '/contact/' },
		],
	},
	{
		title: 'Insights',
		links: [
			{ label: 'Blog', href: '/blog/' },
			{ label: 'News', href: '/news/' },
		],
	},
];
---

<footer class="growpha-footer">
	<div class="footer-glow-line" aria-hidden="true"></div>

	<div class="footer-cta">
		<div class="gp-container">
			<div class="footer-cta-grid">
				<div>
					<div class="footer-cta-h2">
						Ready to build growth that<br />
						<span class="text-gradient-orange">actually compounds?</span>
					</div>
					<p class="footer-cta-lead">No retainers for the sake of it. No vanity metrics. Just measurable, technical growth.</p>
				</div>
				<div class="footer-cta-actions">
					<a href="/contact/" class="ghero-btn-primary">
						Start a Conversation
						<span set:html={arrowRight} />
					</a>
					<a href="/services/" class="ghero-btn-ghost">Explore Services</a>
				</div>
			</div>
		</div>
	</div>

	<div class="gp-container footer-main">
		<div class="footer-grid">
			<div class="footer-brand">
				<a href="/" class="footer-logo-link">
					<Image src={Logo} alt="Growpha" width={40} height={40} class="footer-logo" />
				</a>
				<p class="footer-brand-desc">
					Technical growth infrastructure for businesses that take search, AI, and digital performance
					seriously.
				</p>
				<div class="footer-trust">
					<div class="footer-trust-item">
						<span class="footer-trust-icon" set:html={circleCheck} />
						<span>10+ years in technical SEO</span>
					</div>
					<div class="footer-trust-item">
						<span class="footer-trust-icon" set:html={circleCheck} />
						<span>AI-native workflows</span>
					</div>
				</div>
				<a
					href="https://www.linkedin.com/in/fadilileri34/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class="footer-social-btn"
					set:html={linkedinIcon}
				/>
			</div>

			<div class="footer-links">
				{
					linkColumns.map((col) => (
						<div class="footer-link-col">
							<div class="footer-link-title">{col.title}</div>
							<ul>
								{col.links.map((link) => (
									<li>
										<a href={link.href} target={link.external ? '_blank' : undefined}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>

			<div class="footer-newsletter-wrap">
				<div class="footer-newsletter">
					<div class="footer-newsletter-label">Growth Intelligence</div>
					<p class="footer-newsletter-desc">
						Occasional insights on SEO, AI search, and digital systems. No noise, no newsletters for the
						sake of it.
					</p>
					<form
						class="footer-newsletter-form"
						name="newsletter"
						method="POST"
						data-netlify="true"
						data-netlify-honeypot="bot-field"
						data-newsletter-form
					>
						<input type="hidden" name="form-name" value="newsletter" />
						<p class="hp-field"><label>Don't fill this out: <input name="bot-field" /></label></p>
						<input type="email" name="email" placeholder="your@email.com" required />
						<button type="submit" class="ghero-btn-primary full-width" data-submit-btn>
							Subscribe
							<span set:html={arrowRight} />
						</button>
					</form>
					<p class="footer-newsletter-note" data-form-note></p>
				</div>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="gp-container">
			<div class="footer-bottom-row">
				<p>&copy; {today.getFullYear()} Growpha. All rights reserved.</p>
			</div>
		</div>
	</div>
</footer>

<script>
	const newsletterForm = document.querySelector('[data-newsletter-form]') as HTMLFormElement | null;

	newsletterForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		const button = newsletterForm.querySelector('[data-submit-btn]') as HTMLButtonElement | null;
		const note = newsletterForm.parentElement?.querySelector('[data-form-note]');
		if (button) button.disabled = true;
		const body = new URLSearchParams(new FormData(newsletterForm) as any).toString();
		fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body })
			.then(() => {
				newsletterForm.reset();
				newsletterForm.style.display = 'none';
				if (note) {
					note.textContent = "Subscribed — thanks for signing up.";
					note.classList.add('footer-newsletter-note-success');
				}
			})
			.catch(() => {
				if (button) button.disabled = false;
				if (note) note.textContent = 'Something went wrong — please try again later.';
			});
	});
</script>

<style>
	.growpha-footer {
		background: var(--growpha-black);
		position: relative;
		overflow: hidden;
	}
	.footer-glow-line {
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(34, 197, 94, 0.35) 30%,
			rgba(34, 197, 94, 0.35) 70%,
			transparent 100%
		);
	}

	.footer-cta {
		background: var(--growpha-surface-2);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}
	.footer-cta-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		align-items: center;
		padding: 48px 0;
	}
	@media (min-width: 1024px) {
		.footer-cta-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	.footer-cta-h2 {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		letter-spacing: -0.025em;
		line-height: 1.15;
		color: var(--growpha-text-primary);
		margin-bottom: 10px;
	}
	.footer-cta-lead {
		color: var(--growpha-text-secondary);
		font-size: 0.9375rem;
		line-height: 1.65;
		margin: 0;
	}
	.footer-cta-actions {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	@media (min-width: 640px) {
		.footer-cta-actions {
			flex-direction: row;
		}
	}
	@media (min-width: 1024px) {
		.footer-cta-actions {
			justify-content: flex-end;
		}
	}

	.footer-main {
		padding: 56px 20px;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
	}
	@media (min-width: 1024px) {
		.footer-grid {
			grid-template-columns: repeat(12, 1fr);
			gap: 56px;
		}
		.footer-brand {
			grid-column: span 3;
		}
		.footer-links {
			grid-column: span 6;
		}
		.footer-newsletter-wrap {
			grid-column: span 3;
		}
	}

	.footer-logo-link {
		display: inline-flex;
		margin-bottom: 20px;
	}
	.footer-logo {
		height: 40px;
		width: 40px;
		border-radius: 8px;
		display: block;
	}
	.footer-brand-desc {
		color: var(--growpha-text-secondary);
		font-size: 0.875rem;
		line-height: 1.75;
		margin: 0 0 24px;
	}
	.footer-trust {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 24px;
	}
	.footer-trust-item {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.footer-trust-icon {
		display: flex;
		color: var(--growpha-green-bright);
		flex-shrink: 0;
	}
	.footer-trust-item span:last-child {
		font-size: 0.8rem;
		color: var(--growpha-text-muted);
	}
	.footer-social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 8px;
		background: rgba(249, 115, 22, 0.08);
		border: 1.5px solid var(--growpha-orange);
		color: var(--growpha-orange);
		transition: background 0.2s, box-shadow 0.2s;
	}
	.footer-social-btn:hover {
		background: rgba(249, 115, 22, 0.16);
		box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.12);
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}
	@media (min-width: 640px) {
		.footer-links {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.footer-link-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--growpha-text-muted);
		margin-bottom: 16px;
	}
	.footer-link-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.footer-link-col a {
		font-size: 0.875rem;
		color: var(--growpha-text-secondary);
		text-decoration: none;
		line-height: 1.4;
		transition: color 0.2s;
	}
	.footer-link-col a:hover {
		color: var(--growpha-text-primary);
	}

	.footer-newsletter {
		padding: 20px;
		border-radius: 16px;
		background: var(--growpha-surface-3);
		border: 1px solid rgba(255, 255, 255, 0.07);
	}
	.footer-newsletter-label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--growpha-green-bright);
		margin-bottom: 12px;
	}
	.footer-newsletter-desc {
		color: var(--growpha-text-secondary);
		font-size: 0.8125rem;
		line-height: 1.65;
		margin: 0 0 20px;
	}
	.footer-newsletter-form {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.footer-newsletter-form input {
		width: 100%;
		box-sizing: border-box;
		background: var(--growpha-surface-2);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		padding: 10px 14px;
		color: var(--growpha-text-primary);
		font-family: var(--font-body);
		font-size: 0.875rem;
		outline: none;
		transition: border-color 0.2s;
	}
	.footer-newsletter-form input:focus {
		border-color: rgba(249, 115, 22, 0.5);
	}
	.ghero-btn-primary.full-width {
		width: 100%;
		justify-content: center;
		font-size: 0.875rem;
		padding: 10px 16px;
	}
	.footer-newsletter-note {
		margin: 10px 0 0;
		font-size: 0.8125rem;
		color: var(--growpha-text-muted);
	}
	.footer-newsletter-note:empty {
		display: none;
	}
	.footer-newsletter-note-success {
		color: var(--growpha-green-bright);
		font-weight: 600;
	}
	.hp-field {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}
	.footer-bottom-row {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 20px 0;
	}
	@media (min-width: 640px) {
		.footer-bottom-row {
			flex-direction: row;
		}
	}
	.footer-bottom-row p {
		font-size: 0.8rem;
		color: var(--growpha-text-muted);
		margin: 0;
	}
</style>
